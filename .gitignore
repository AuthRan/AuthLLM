__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/
/checkpoints/
/pretrained/
/data/
*.safetensors

# Generated training artifacts (reproducible via scripts/train_tokenizer.py)
/tokenizer.json

# Staging area for checkpoints/tokenizers downloaded off Kaggle (large binaries)
/required_downloads/

# Runtime artifacts for the HF Space -- uploaded to the Space directly (git-LFS
# there), never committed to this source repo. The Space code lives in space/.
/space/model.pt
/space/tokenizer.json

# Env files / secrets -- never commit tokens
.env
.env.*
*.env

# tiktoken marker file (regenerate: TiktokenBPETokenizer().save(...))
/tokenizer_gpt2.json

# Operational log for the automated status sync (noise, not history)
/logs/sync_status.log

# Same for the boot-resume log, and the supervisor's run lock
/logs/resume_on_boot.log
/logs/.training.lock

# Console output of scripts/eval_instruction_following.py -- the same tables are
# committed in results/instruction_eval_*.md, with every generation behind them
/logs/instruction_eval_*.log

# Console output of the preference evaluations -- same rule as the line above:
# the tables they print are committed in results/preference_eval_*.md and
# results/instruction_eval_dpo*.md, with every generation behind them
/logs/dpo_*_eval.log
/logs/chat_eval*.log

# Personal CV source kept in the repo for convenience while the project's
# resume bullets are being rewritten from its measured numbers. Not part of
# the project and never published with it.
/resume.txt
